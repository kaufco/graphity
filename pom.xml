<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.kobayami</groupId>
  <artifactId>graphity-parent</artifactId>
  <version>3.0.0</version>
  <packaging>pom</packaging>

  <name>graphity (parent)</name>
  <description>Parent POM of Graphity, a library of graph analysis algorithms for Java.</description>
  <url>https://github.com/kaufco/graphity</url>
  <inceptionYear>2025</inceptionYear>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <organization>
    <name>kaufco</name>
    <url>https://github.com/kaufco</url>
  </organization>

  <developers>
    <developer>
      <id>kaufco</id>
      <name>Marco Kaufmann</name>
      <url>https://github.com/kaufco</url>
      <roles>
        <role>author</role>
        <role>maintainer</role>
      </roles>
      <timezone>Europe/Berlin</timezone>
    </developer>
  </developers>

  <!-- The child.*.inherit.append.path attributes (here and on <project>) stop Maven
       from appending the module directory to inherited URLs. Without them the
       published graphity-core POM would advertise .../graphity/graphity-core, which
       does not exist. -->
  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/kaufco/graphity.git</connection>
    <developerConnection>scm:git:git@github.com:kaufco/graphity.git</developerConnection>
    <url>https://github.com/kaufco/graphity</url>
    <tag>HEAD</tag>
  </scm>

  <!-- No <distributionManagement> on purpose. Sonatype OSSRH was sunset in
       mid-2025; Maven Central now publishes through the Central Publisher Portal,
       whose deploy plugin takes the place of a <repository> entry. See the
       "release" profile at the bottom of this file. -->
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/kaufco/graphity/issues</url>
  </issueManagement>

  <modules>
    <module>graphity-core</module>
    <module>graphity-controlflow</module>
    <module>graphity-dot</module>
    <module>graphity-mermaid</module>
    <module>graphity</module>
    <module>graphity-bom</module>
    <module>graphity-benchmarks</module>
    <module>graphity-examples</module>
  </modules>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Set by the release profile, so that the test-utility jar of graphity-core never
         reaches a Maven Central bundle. -->
    <graphity.skipTestJar>false</graphity.skipTestJar>
    <!-- The modules a release publishes, comma-separated, all at this POM's version.
         release.yml and deploy-javadoc.yml read this list and build it with -pl <list> -am
         (plus this parent POM, which consumers need to resolve the modules): the Central
         bundle and the aggregated Javadoc site cover these modules. A module that is not
         listed is built and tested by CI but not deployed - the benchmarks, the examples, and
         any future module without a consumer yet. Each entry is both a directory (-pl) and an
         artifactId (the Central pre-check), so the two must match; and since -am also builds
         and publishes the reactor dependencies of a listed module, each of those must be
         listed too. -->
    <graphity.releaseModules>graphity-core,graphity-controlflow,graphity-dot,graphity-mermaid,graphity,graphity-bom</graphity.releaseModules>

    <fastutil.version>8.5.17</fastutil.version>
    <jspecify.version>1.0.0</jspecify.version>
    <junit.version>5.11.3</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <jgrapht.version>1.5.2</jgrapht.version>
    <guava.version>33.5.0-jre</guava.version>
    <webgraph.version>3.6.12</webgraph.version>
    <slf4j.version>2.0.16</slf4j.version>
    <jmh.version>1.37</jmh.version>
    <jol.version>0.17</jol.version>

    <!-- Error Prone runs inside javac, on the JDK 25 of the build; from 2.43 on, it needs JDK 21
         or newer to run. NullAway needs Error Prone 2.36+. -->
    <errorprone.version>2.51.0</errorprone.version>
    <nullaway.version>0.14.2</nullaway.version>

    <compiler-plugin.version>3.11.0</compiler-plugin.version>
    <surefire.version>3.5.2</surefire.version>
    <jacoco.version>0.8.13</jacoco.version>
    <shade-plugin.version>3.5.3</shade-plugin.version>
    <javadoc-plugin.version>3.11.2</javadoc-plugin.version>
    <source-plugin.version>3.3.1</source-plugin.version>
    <jar-plugin.version>3.4.1</jar-plugin.version>
    <build-helper-plugin.version>3.6.1</build-helper-plugin.version>
    <gpg-plugin.version>3.2.8</gpg-plugin.version>
    <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
    <enforcer-plugin.version>3.5.0</enforcer-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>it.unimi.dsi</groupId>
        <artifactId>fastutil</artifactId>
        <version>${fastutil.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${jspecify.version}</version>
      </dependency>

      <dependency>
        <groupId>com.kobayami</groupId>
        <artifactId>graphity-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.kobayami</groupId>
        <artifactId>graphity-controlflow</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.kobayami</groupId>
        <artifactId>graphity-dot</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.kobayami</groupId>
        <artifactId>graphity-mermaid</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.kobayami</groupId>
        <artifactId>graphity</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jgrapht</groupId>
        <artifactId>jgrapht-core</artifactId>
        <version>${jgrapht.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>it.unimi.dsi</groupId>
        <artifactId>webgraph</artifactId>
        <version>${webgraph.version}</version>
        <exclusions>
          <!-- webgraph 3.6.x declares logback as a runtime dependency and JUNG as compile-
               scope. We don't need either: slf4j-nop provides a silent logger, and JUNG
               would only bloat the shade-jar. Excluding them avoids a second SLF4J binding
               that would otherwise beat slf4j-nop in the service-provider lottery. -->
          <exclusion>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
          </exclusion>
          <exclusion>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
          </exclusion>
          <exclusion>
            <groupId>net.sf.jung</groupId>
            <artifactId>jung-api</artifactId>
          </exclusion>
          <exclusion>
            <groupId>net.sf.jung</groupId>
            <artifactId>jung-io</artifactId>
          </exclusion>
          <exclusion>
            <groupId>net.sf.jung</groupId>
            <artifactId>jung-algorithms</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <!-- WebGraph / dsiutils log through SLF4J; silence the output to keep benchmark
           stderr clean. Using slf4j-nop avoids a real binding entirely. -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-nop</artifactId>
        <version>${slf4j.version}</version>
      </dependency>

      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-core</artifactId>
        <version>${jmh.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-generator-annprocess</artifactId>
        <version>${jmh.version}</version>
      </dependency>

      <dependency>
        <groupId>org.openjdk.jol</groupId>
        <artifactId>jol-core</artifactId>
        <version>${jol.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler-plugin.version}</version>
          <configuration>
            <release>17</release>
          </configuration>
          <executions>
            <!-- NullAway checks the main code of every @NullMarked package against its
                 JSpecify annotations, in JSpecify mode also inside type arguments, type variables
                 and arrays; tests are not part of the contract and stay unchecked.
                 Of Error Prone, only NullAway runs. Running Error Prone inside javac needs
                 the exports in .mvn/jvm.config. -->
            <execution>
              <id>default-compile</id>
              <configuration>
                <compilerArgs>
                  <arg>-XDcompilePolicy=simple</arg>
                  <arg>--should-stop=ifError=FLOW</arg>
                  <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true</arg>
                </compilerArgs>
                <annotationProcessorPaths>
                  <path>
                    <groupId>com.google.errorprone</groupId>
                    <artifactId>error_prone_core</artifactId>
                    <version>${errorprone.version}</version>
                  </path>
                  <path>
                    <groupId>com.uber.nullaway</groupId>
                    <artifactId>nullaway</artifactId>
                    <version>${nullaway.version}</version>
                  </path>
                </annotationProcessorPaths>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <argLine>@{argLine} -ea</argLine>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals><goal>prepare-agent</goal></goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>test</phase>
              <goals><goal>report</goal></goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${source-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar-plugin.version}</version>
        </plugin>

        <plugin>
          <!-- Each module adds graphity-core/src/testutils/java, the graph generators and
               oracles shared by the tests of every module, as a test source root. A source root
               rather than a dependency on the test jar of graphity-core: the release profile does
               not build that jar, and a module whose tests depended on it would fail to
               release. -->
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build-helper-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${javadoc-plugin.version}</version>
          <configuration>
            <source>${maven.compiler.source}</source>
            <encoding>${project.build.sourceEncoding}</encoding>
            <docencoding>UTF-8</docencoding>
            <charset>UTF-8</charset>
            <doclint>all</doclint>
            <failOnWarnings>true</failOnWarnings>
            <!-- Class path, not module path: the jars carry an Automatic-Module-Name but no
                 module-info, and in module mode the aggregated site finds no sources for the
                 packages of the automatic modules. -->
            <legacyMode>true</legacyMode>
            <notimestamp>true</notimestamp>
            <quiet>true</quiet>
            <!-- One title for the per-module Javadoc jars and the aggregated site alike;
                 ${project.name} would name the parent POM on the aggregated site. -->
            <doctitle>Graphity for Java ${project.version}</doctitle>
            <windowtitle>Graphity for Java ${project.version}</windowtitle>
            <!-- The doctitle shows only on an overview page, which the aggregated site gets from
                 src/main/javadoc/overview.html and a single-package module jar does not; the
                 header puts the version on every page. -->
            <header>Graphity for Java ${project.version}</header>
            <!-- Types of the dependencies get their short names and a link to their documentation.
                 The element lists lie in the repository, so the build needs no third-party site. -->
            <offlineLinks>
              <offlineLink>
                <url>https://fastutil.di.unimi.it/docs/</url>
                <location>${maven.multiModuleProjectDirectory}/src/javadoc-links/fastutil</location>
              </offlineLink>
              <offlineLink>
                <url>https://jspecify.dev/docs/api/</url>
                <location>${maven.multiModuleProjectDirectory}/src/javadoc-links/jspecify</location>
              </offlineLink>
            </offlineLinks>
            <!-- One group per published module with code, on the aggregated site. -->
            <groups>
              <group>
                <title>graphity-core</title>
                <packages>com.kobayami.graphity</packages>
              </group>
              <group>
                <title>graphity-controlflow</title>
                <packages>com.kobayami.graphity.controlflow</packages>
              </group>
              <group>
                <title>graphity-dot</title>
                <packages>com.kobayami.graphity.dot</packages>
              </group>
              <group>
                <title>graphity-mermaid</title>
                <packages>com.kobayami.graphity.mermaid</packages>
              </group>
            </groups>
            <bottom><![CDATA[Copyright &#169; {inceptionYear}&#x2013;{currentYear} Marco Kaufmann. Apache License 2.0.]]></bottom>

            <!-- No links to the Javadoc of sibling modules: the plugin would point them at the
                 project URL, where no per-module Javadoc is published. -->
            <detectOfflineLinks>false</detectOfflineLinks>
            <links>
              <link>https://docs.oracle.com/en/java/javase/17/docs/api/</link>
            </links>
            <linksource>true</linksource>
            <!-- {@snippet file="..." region="..."} embeds a region of a source file of
                 graphity-examples, whose build compiles the examples and whose tests check what
                 their comments claim. An absolute path, because the Javadoc jar of each module
                 and javadoc:aggregate run in different directories; the directory with .mvn is
                 the repository root, from wherever Maven starts. -->
            <additionalOptions>
              <additionalOption>--snippet-path</additionalOption>
              <additionalOption>${maven.multiModuleProjectDirectory}/graphity-examples/src/main/java</additionalOption>
              <!-- The Graphity theme on top of the standard stylesheet, and colored examples. -->
              <additionalOption>--add-stylesheet</additionalOption>
              <additionalOption>${maven.multiModuleProjectDirectory}/src/main/javadoc/graphity-javadoc.css</additionalOption>
              <additionalOption>--syntax-highlight</additionalOption>
            </additionalOptions>
            <tags>
              <tag><name>apiNote</name><placement>a</placement><head>API Note:</head></tag>
              <tag><name>implSpec</name><placement>a</placement><head>Implementation Requirements:</head></tag>
              <tag><name>implNote</name><placement>a</placement><head>Implementation Note:</head></tag>
            </tags>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <!-- One JDK builds everything - CI, releases, the Javadoc site: JDK 25. The code is
             compiled for Java 17 (release above), the oldest version the library runs on; the CI
             runs the tests of the JDK 25 build on Java 17, 21 and 25. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>require-jdk-25</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>Building Graphity needs JDK 25; the library itself runs on Java 17 and newer.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Publishing to Maven Central needs PGP signatures and the Central Portal
       deploy plugin, but a plain `mvn verify` must not ask for a GPG passphrase.
       Both therefore live in a profile that only the release build activates:

         mvn -pl <graphity.releaseModules> -am clean deploy -P release

       The reactor is deliberately narrowed to the parent POM (which consumers
       need in order to resolve the modules) and the modules listed in
       graphity.releaseModules. -->
  <profiles>
    <profile>
      <id>release</id>
      <properties>
        <graphity.skipTestJar>true</graphity.skipTestJar>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
            <configuration>
              <!-- Loopback pinentry lets gpg take the passphrase from
                   MAVEN_GPG_PASSPHRASE instead of opening a dialog, which is what
                   a headless release build needs. -->
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-plugin.version}</version>
            <!-- The extension replaces maven-deploy-plugin in the deploy phase and
                 uploads one bundle for the whole reactor. -->
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- The upload waits for the portal's validation, then stops: the
                   release is published by hand from the Deployments page. -->
              <autoPublish>false</autoPublish>
              <!-- Not ${project.artifactId}: the upload is triggered by the last
                   module of the reactor, so the name would follow whichever module
                   that happens to be. -->
              <deploymentName>graphity ${project.version}</deploymentName>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
