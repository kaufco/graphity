{
  "name": "full",
  "description": "Balanced full profile (~1-2h target): all libs on 10k/100k, no >100k cases.",
  "jmh": {
    "forks": 1,
    "warmup_iterations": 1,
    "warmup_time": "1s",
    "measurement_iterations": 3,
    "measurement_time": "1s",
    "jvm_stack": "-Xss128m"
  },
  "cases": [
    {
      "name": "build",
      "libraries": ["graphity", "jgrapht", "guava", "webgraph"],
      "algorithms": ["build"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"]
      }
    },
    {
      "name": "adjacency-traversal",
      "libraries": ["graphity"],
      "algorithms": ["outtraversal", "intraversal"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"]
      },
      "phases": ["perf"]
    },
    {
      "name": "scc",
      "libraries": ["graphity", "jgrapht", "guava", "webgraph"],
      "algorithms": ["scc"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"]
      }
    },
    {
      "name": "toporder",
      "libraries": ["graphity", "jgrapht", "guava", "webgraph"],
      "algorithms": ["toporder"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "DAG_GNP_SPARSE", "DAG_GNP_DENSE", "PATH_SHUFFLED", "TREE_SHUFFLED", "DAG_GNP_DENSE_SHUFFLED"]
      }
    },
    {
      "name": "dfs-analysis",
      "libraries": ["graphity", "jgrapht", "guava", "webgraph"],
      "algorithms": ["backedges", "edgetypes"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"]
      }
    },
    {
      "name": "wcc",
      "libraries": ["graphity", "jgrapht", "guava", "webgraph"],
      "algorithms": ["wcc"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"]
      }
    },
    {
      "name": "ccs-graphity",
      "libraries": ["graphity"],
      "algorithms": ["ccs"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"]
      }
    },
    {
      "name": "toporder-levels",
      "libraries": ["graphity", "graphity-biadjacent", "jgrapht", "guava", "webgraph"],
      "algorithms": ["toporderandlevels"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "DAG_GNP_SPARSE", "DAG_GNP_DENSE", "PATH_SHUFFLED", "TREE_SHUFFLED", "DAG_GNP_DENSE_SHUFFLED"]
      }
    },
    {
      "name": "condense-graphity",
      "libraries": ["graphity"],
      "algorithms": ["condense"],
      "params": {
        "nodeCount": [1000, 10000, 100000],
        "shape": ["PATH", "CHAIN_OF_CLIQUES", "GNP_DENSE", "DAG_GNP_SPARSE"]
      }
    },
    {
      "name": "reordered-graph-algos",
      "libraries": ["graphity-reordered"],
      "algorithms": ["scc", "wcc", "ccs", "backedges", "edgetypes"],
      "phases": ["perf"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"]
