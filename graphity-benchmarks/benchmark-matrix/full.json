    },
    {
      "name": "dominance-frontiers",
      "libraries": ["graphity"],
      "algorithms": ["dominancefrontiers"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["STRUCTURED", "IRREDUCIBLE", "CHAIN", "SMALL_METHODS"]
      }
    },
    {
      "name": "dominance-frontiers-quadratic",
      "description": "The frontier relation itself is quadratic on these shapes: about 12.5 and 25 million pairs at 10k nodes, more than an array holds at 100k.",
      "libraries": ["graphity"],
      "algorithms": ["dominancefrontiers"],
      "params": {
        "nodeCount": [10000],
        "shape": ["LADDER", "FAN_BEHIND_CHAIN"]
      }
    }
  ],
  "mem": {
    "enabled": true,
    "nodes": [10000, 100000],
    "shapes": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"],
    "libraries": ["graphity", "jgrapht", "guava", "webgraph"]
  }
}
