      }
    },
    {
      "name": "reorder-cost",
      "libraries": ["graphity"],
      "algorithms": ["reorder"],
      "phases": ["perf"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"]
      }
    },
    {
      "name": "biadjacency-cost",
      "libraries": ["graphity"],
      "algorithms": ["biadjacency"],
      "phases": ["perf"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"]
      }
    },
    {
      "name": "symmetrize-cost",
      "libraries": ["webgraph"],
      "algorithms": ["symmetrize"],
      "phases": ["perf"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["PATH", "TREE", "GNP_SPARSE", "GNP_DENSE", "CHAIN_OF_CLIQUES", "PATH_SHUFFLED", "GNP_DENSE_SHUFFLED", "CHAIN_OF_CLIQUES_SHUFFLED"]
      }
    },
    {
      "name": "control-flow",
      "libraries": ["graphity"],
      "algorithms": ["dominators", "iterateddominancefrontier", "loops", "dominatorancestry", "preorderancestry"],
      "params": {
        "nodeCount": [10000, 100000],
        "shape": ["STRUCTURED", "IRREDUCIBLE", "LADDER", "CHAIN", "FAN_BEHIND_CHAIN", "SMALL_METHODS"]
